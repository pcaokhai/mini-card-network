# Copy to .env.local for local development. None of these are secrets.

# BFF upstreams (src/app/api/[...path]/route.ts): the browser calls /api/v1/..., the server forwards.
GATEWAY_URL=http://localhost:8080
# Card administration, accounts and the issuer key inventory belong to the issuer (docs/04 §1).
ISSUER_ADMIN_URL=http://localhost:8081

# WebSocket for live updates (link.status, network.event, chaos.run.progress, ...). Route Handlers
# can't hold a WebSocket open (node_modules/next/dist/docs/01-app/02-guides/backend-for-frontend.md),
# so the browser connects to the gateway's /v1/stream directly. Unset, it tries same-origin
# /v1/stream, which only works behind a reverse proxy that forwards it (NET-G8).
NEXT_PUBLIC_WS_URL=ws://localhost:8080/v1/stream

# true: serve every API call from the MSW mocks in src/mocks (pnpm dev:mock sets it).
NEXT_PUBLIC_API_MOCKS=false
