# Lab-only values. Copy to .env (git-ignored). Never put real secrets here.
COMPOSE_PROJECT_NAME=mini-card-network
POSTGRES_PASSWORD=lab-postgres
POSTGRES_HOST_PORT=5432
ISSUER_DB_PASSWORD=lab-issuer
ACQUIRER_DB_PASSWORD=lab-acquirer
SETTLEMENT_DB_PASSWORD=lab-settlement
GRAFANA_ADMIN_PASSWORD=lab-grafana
# Used by services from MCN-005 onwards
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# Empty by default. Set to http://localhost:3000 for local dev if web-next needs to call the
# gateway directly from the browser (docs/09-risk-register.md R-10 - workaround for the missing
# BFF proxy layer). Leave unset once a real BFF exists.
CORS_ALLOWED_ORIGIN=
