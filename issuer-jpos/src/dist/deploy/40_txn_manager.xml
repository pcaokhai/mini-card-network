<?xml version="1.0" encoding="UTF-8"?>
<!--
  Authorization TransactionManager (MCN-302a/302b). Participants run in this exact order per
  docs/06-user-stories.md MCN-302 and issuer-jpos/CLAUDE.md: ParseAndValidate -> Deduplicate ->
  CheckCard -> LogAndOutbox -> VerifyEmv (DE 55 TLV/ATC/ARQC, MCN-602) -> VerifySecurity (real
  MAC/PIN verification, MCN-503) -> CheckLimits -> Authorize -> Respond. LogAndOutbox moved before
  VerifySecurity/CheckLimits/Authorize in MCN-302b: its
  prepare() now inserts the tran_log row up front (status RECEIVED) so Authorize has an
  already-committed row to post its journal_entry against (journal_entry.tran_id has a real,
  non-deferred FK to tran_log) - see LogAndOutbox's class javadoc. Its commit()/abort() still run
  in the finalize phase regardless of this XML position and record the final outcome.
  AuthorizationListener looks this bean up by name ("iso-txn-mgr") via NameRegistrar once it's
  registered in startService().
-->
<txnmgr name="iso-txn-mgr" class="org.jpos.transaction.TransactionManager" logger="Q2">
  <property name="queue" value="iso-txn-mgr-queue" />
  <property name="sessions" value="4" />
  <property name="max-sessions" value="16" />

  <participant class="io.mcn.issuer.adapter.txn.ParseAndValidate" logger="Q2" />

  <participant class="io.mcn.issuer.adapter.txn.Deduplicate" logger="Q2">
    <property name="jdbc-url" value="${DATABASE_URL}" />
    <property name="jdbc-user" value="${DB_USER}" />
    <property name="jdbc-password" value="${DB_PASSWORD}" />
  </participant>

  <participant class="io.mcn.issuer.adapter.txn.CheckCard" logger="Q2">
    <property name="jdbc-url" value="${DATABASE_URL}" />
    <property name="jdbc-user" value="${DB_USER}" />
    <property name="jdbc-password" value="${DB_PASSWORD}" />
  </participant>

  <participant class="io.mcn.issuer.adapter.txn.LogAndOutbox" logger="Q2">
    <property name="jdbc-url" value="${DATABASE_URL}" />
    <property name="jdbc-user" value="${DB_USER}" />
    <property name="jdbc-password" value="${DB_PASSWORD}" />
  </participant>

  <participant class="io.mcn.issuer.adapter.txn.VerifyEmv" logger="Q2">
    <property name="jdbc-url" value="${DATABASE_URL}" />
    <property name="jdbc-user" value="${DB_USER}" />
    <property name="jdbc-password" value="${DB_PASSWORD}" />
  </participant>

  <participant class="io.mcn.issuer.adapter.txn.VerifySecurity" logger="Q2">
    <property name="jdbc-url" value="${DATABASE_URL}" />
    <property name="jdbc-user" value="${DB_USER}" />
    <property name="jdbc-password" value="${DB_PASSWORD}" />
  </participant>

  <participant class="io.mcn.issuer.adapter.txn.CheckLimits" logger="Q2">
    <property name="jdbc-url" value="${DATABASE_URL}" />
    <property name="jdbc-user" value="${DB_USER}" />
    <property name="jdbc-password" value="${DB_PASSWORD}" />
  </participant>

  <participant class="io.mcn.issuer.adapter.txn.Authorize" logger="Q2">
    <property name="jdbc-url" value="${DATABASE_URL}" />
    <property name="jdbc-user" value="${DB_USER}" />
    <property name="jdbc-password" value="${DB_PASSWORD}" />
  </participant>

  <participant class="io.mcn.issuer.adapter.txn.Respond" logger="Q2" />
</txnmgr>
