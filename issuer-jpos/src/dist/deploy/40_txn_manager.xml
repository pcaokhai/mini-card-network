<?xml version="1.0" encoding="UTF-8"?>
<!--
  Authorization TransactionManager (MCN-302a). Participants run in this exact order per
  docs/06-user-stories.md MCN-302 and issuer-jpos/CLAUDE.md: ParseAndValidate -> Deduplicate ->
  CheckCard -> VerifySecurity (no-op until E5) -> CheckLimits -> Authorize (decline-only until
  MCN-302b) -> LogAndOutbox -> Respond. AuthorizationListener looks this bean up by name
  ("iso-txn-mgr") via NameRegistrar once it's registered in startService().
-->
<txnmgr name="iso-txn-mgr" class="org.jpos.transaction.TransactionManager" logger="Q2">
  <property name="queue" value="iso-txn-mgr-queue" />
  <property name="sessions" value="4" />
  <property name="max-sessions" value="16" />

  <participant class="io.mcn.issuer.adapter.txn.ParseAndValidate" logger="Q2" />

  <participant class="io.mcn.issuer.adapter.txn.Deduplicate" logger="Q2">
    <property name="jdbc-url" value="${DATABASE_URL}" />
    <property name="jdbc-user" value="${DB_USER}" />
    <property name="jdbc-password" value="${DB_PASSWORD}" />
  </participant>

  <participant class="io.mcn.issuer.adapter.txn.CheckCard" logger="Q2">
    <property name="jdbc-url" value="${DATABASE_URL}" />
    <property name="jdbc-user" value="${DB_USER}" />
    <property name="jdbc-password" value="${DB_PASSWORD}" />
  </participant>

  <participant class="io.mcn.issuer.adapter.txn.VerifySecurity" logger="Q2" />

  <participant class="io.mcn.issuer.adapter.txn.CheckLimits" logger="Q2">
    <property name="jdbc-url" value="${DATABASE_URL}" />
    <property name="jdbc-user" value="${DB_USER}" />
    <property name="jdbc-password" value="${DB_PASSWORD}" />
  </participant>

  <participant class="io.mcn.issuer.adapter.txn.Authorize" logger="Q2" />

  <participant class="io.mcn.issuer.adapter.txn.LogAndOutbox" logger="Q2">
    <property name="jdbc-url" value="${DATABASE_URL}" />
    <property name="jdbc-user" value="${DB_USER}" />
    <property name="jdbc-password" value="${DB_PASSWORD}" />
  </participant>

  <participant class="io.mcn.issuer.adapter.txn.Respond" logger="Q2" />
</txnmgr>
